<collection xmlns="http://exist-db.org/collection-config/1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <index>
        <fulltext default="none" attributes="false"/>

        <lucene>
	        <analyzer id="default" class="org.apache.lucene.analysis.standard.StandardAnalyzer"/>
            <analyzer id="ws" class="org.apache.lucene.analysis.core.WhitespaceAnalyzer"/>

	        <text qname="@classes" analyzer="default"/>
            <text qname="PaymentDetail" analyzer="default"/>
            <text qname="Usage" analyzer="default"/>
            <text qname="Recipient" analyzer="default"/>
            <text qname="CustomerRef" analyzer="default"/>
            <text qname="EndToEndRef" analyzer="default"/>
        </lucene>

        <range>

            <create qname="@id" type="xs:string"/>
            <create qname="@kto" type="xs:string"/>
            <create qname="@refID" type="xs:string"/>
            <create qname="RefID" type="xs:string"/>
            <!--
            <create qname="@credit" type="xs:integer"/>
            <create qname="@debit" type="xs:integer"/>
            -->

            <!-- common -->
            <create qname="@type" type="xs:string"/> <!-- xs:NCNAME -->
            <create qname="Owner" type="xs:integer"/>
            <create qname="Other" type="xs:integer"/>
            <create qname="@amount" type="xs:double"/>
            <create qname="@value" type="xs:double"/>
            <create qname="@name" type="xs:string"/>

            <!-- Process -->
            <create qname="Process">
                <field name="pro-id" match="@date" type="xs:date"/>
                <field name="pro-date" match="@binder" type="xs:string"/>
            </create>

            <!-- Accounting -->
            <create qname="PaymentTask">
                <field name="payment-RefID" match="RefID" type="xs:string"/>
             </create>

            <!-- Booking -->
            <create qname="Booking">
                <field name="booking-id" match="@id" type="xs:string"/>
                <field name="booking-date" match="@date" type="xs:date"/>
                <field name="booking-credit" match="@credit" type="xs:integer"/>
                <field name="booking-debit" match="@debit" type="xs:integer"/>
                <field name="booking-amountValue" match="@amountValue" type="xs:string"/>
                <field name="booking-amountUnit" match="@amountUnit" type="xs:string"/>
                <field name="booking-refID" match="@refID" type="xs:string"/>
            </create>


            <!-- Banking -->
            <create qname="Account">
                <field name="acc-kto" match="@kto" type="xs:string"/>
                <field name="acc-id" match="@id" type="xs:string"/>
                <field name="acc-type" match="@type" type="xs:string"/>
                <field name="acc-classes" match="@clases" type="xs:string"/>
                <field name="acc-Name" match="Name" type="xs:string"/>
                <field name="acc-CreditorID" match="CreditorID" type="xs:string"/>
            </create>

            <!-- Banking -->
            <create qname="BankAccount">
                <field name="BankAccount-kto" match="@kto" type="xs:string"/>
            </create>

            <create qname="Accounting">
                <field name="bank-id" match="@id" type="xs:string"/>
                <field name="bank-Amount" match="Amount" type="xs:double"/>
                <field name="bank-ValueDate" match="ValueDate" type="xs:date"/>
                <field name="bank-BookingDate" match="BookingDate" type="xs:date"/>
                <field name="bank-IBAN" match="IBAN" type="xs:string"/>
                <field name="bank-CreditorID" match="CreditorID" type="xs:string"/>
            </create>

            <!--
            <create qname="RefID">
                <field name="PayRefID" type="xs:string" match="//PaymentTask"/>
            </create>
            <create qname="@refID">
                <field name="PayBookRefID" type="xs:string" match="//PaymentTask/Bookings/Booking"/>
            </create>
            -->

            <!--
            <create qname="TransactionID" type="xs:string" case="no"/>
            <create qname="CustomerRef" type="xs:string"/>
            <create qname="MandantRef" type="xs:string"/>
            -->
        </range>

        <!--
        <ngram qname="TransactionID"/>
        <ngram qname="CustomerRef"/>
        <ngram qname="MandantRef"/>
        -->

    </index>
</collection>
