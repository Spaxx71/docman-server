<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="Documents">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="Process"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Process">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Section"/>
        <xs:element name="TotalAmount">
          <xs:complexType>
            <xs:attribute ref="value"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="Tasks">
          <xs:complexType>
            <xs:sequence>
              <xs:group ref="MainTasks"/>
              <xs:group maxOccurs="unbounded" ref="AttachTasks" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Notes" type="Notes"/>
      </xs:sequence>
      <xs:attribute name="id" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:ID">
            <xs:pattern value="PRO[0-9a-f\-]+"/>
            <xs:minLength value="10"/>
            <xs:maxLength value="40"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="name" use="required" type="Filename">
        <xs:annotation>
          <xs:documentation/>
        </xs:annotation>
      </xs:attribute>
      <xs:attribute name="binder" use="required" type="xs:string"/>
      <xs:attribute name="date" use="required" type="xs:date"/>
      <xs:attribute name="created" use="required" type="xs:dateTime"/>
      <xs:attribute name="changed" type="xs:dateTime"/>
      <xs:attribute name="user" use="required" type="xs:string"/>
    </xs:complexType>
  </xs:element>
  <xs:group name="MainTasks">
    <xs:choice>
      <xs:element name="SimpleTask">
        <xs:annotation>
          <xs:documentation>Wie z. B. Notiz oder Vertrag</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:complexContent>
            <xs:extension base="Task">
              <xs:sequence>
                <xs:element name="Files">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="File" maxOccurs="1" minOccurs="0" type="FileType">
                      </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Bookings">
                  <xs:annotation>
                    <xs:documentation>no subelements allowed</xs:documentation>
                  </xs:annotation>
                </xs:element>
                <xs:element name="Owner" type="xs:positiveInteger"> </xs:element>
                <xs:element name="RefID" type="RefID" maxOccurs="1"/>
                <xs:element name="Description">
                  <xs:simpleType>
                    <xs:restriction base="Description">
                      <xs:minLength value="1"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
              </xs:sequence>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="DocumentTask">
        <xs:annotation>
          <xs:documentation>Für alle Arten von Ablage Dokument</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:complexContent>
            <xs:extension base="Task">
              <xs:sequence>
                <xs:element name="Files">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="File" maxOccurs="1" type="FileType"> </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Bookings">
                  <xs:annotation>
                    <xs:documentation>no subelements allowed</xs:documentation>
                  </xs:annotation>
                </xs:element>
                <xs:element name="Owner" type="xs:positiveInteger"> </xs:element>
                <xs:element name="DocName">
                  <xs:simpleType>
                    <xs:restriction base="xs:string">
                      <xs:minLength value="4"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
                <xs:element name="RefID" type="xs:string" maxOccurs="1" minOccurs="0"/>
                <xs:element name="Description">
                  <xs:simpleType>
                    <xs:restriction base="Description">
                      <xs:minLength value="1"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
              </xs:sequence>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="InvoiceInTask">
        <xs:annotation>
          <xs:documentation>Rechnung (eingehend)</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:complexContent>
            <xs:extension base="Task">
              <xs:sequence>
                <xs:element name="Files">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="File" maxOccurs="1" type="FileType"> </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Bookings">
                  <xs:annotation>
                    <xs:documentation>no subelements allowed</xs:documentation>
                  </xs:annotation>
                </xs:element>
                <xs:element name="Amount">
                  <xs:annotation>
                    <xs:documentation>### Ende der Elemente vom Typ "Task" ###</xs:documentation>
                  </xs:annotation>
                </xs:element>
                <xs:element name="Owner" type="xs:positiveInteger"> </xs:element>
                <xs:element name="RefID" type="RefID"/>
                <xs:element name="TransactionID" type="TransactionID"/>
                <xs:element name="Description">
                  <xs:simpleType>
                    <xs:restriction base="Description">
                      <xs:minLength value="1"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
              </xs:sequence>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="InvoiceOutTask">
        <xs:annotation>
          <xs:documentation>Rechnung (ausgehend)</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:complexContent>
            <xs:extension base="Task">
              <xs:sequence>
                <xs:element name="Files">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="File" maxOccurs="1" type="FileType"> </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Bookings">
                  <xs:annotation>
                    <xs:documentation>no subelements allowed</xs:documentation>
                  </xs:annotation>
                </xs:element>
                <xs:element name="Amount">
                  <xs:annotation>
                    <xs:documentation>### Ende der Elemente vom Typ "Task" ###</xs:documentation>
                  </xs:annotation>
                </xs:element>
                <xs:element name="Owner" type="xs:positiveInteger"> </xs:element>
                <xs:element name="RefID" type="RefID"/>
                <xs:element name="TransactionID" type="TransactionID"/>
                <xs:element name="Description">
                  <xs:simpleType>
                    <xs:restriction base="Description">
                      <xs:minLength value="1"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
              </xs:sequence>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="PeriodicPayment">
        <xs:annotation>
          <xs:documentation>Dauerbuchung / Montatliche Kosten</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:complexContent>
            <xs:extension base="Task">
              <xs:sequence>
                <xs:element name="Files">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="File" maxOccurs="1" minOccurs="0" type="FileType">
                      </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Bookings">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="Booking" maxOccurs="1" minOccurs="1" type="Booking">
                      </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Amount">
                  <xs:annotation>
                    <xs:documentation>### Ende der Elemente vom Typ "Task" ###</xs:documentation>
                  </xs:annotation>
                </xs:element>
                <xs:element name="Owner" type="xs:positiveInteger"> </xs:element>
                <xs:element name="RefID" type="RefID"/>
                <xs:element name="TransactionID" type="TransactionID"/>
                <xs:element name="Description">
                  <xs:simpleType>
                    <xs:restriction base="Description">
                      <xs:minLength value="1"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
              </xs:sequence>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="BankBalancingTask">
        <xs:annotation>
          <xs:documentation>Kontoausgleich (Überwiesunge zwischen eigenen
            Bankkonen)</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:complexContent>
            <xs:extension base="Task">
              <xs:sequence>
                <xs:element name="Files">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="File" maxOccurs="1" minOccurs="0" type="FileType">
                      </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Bookings">
                  <xs:annotation>
                    <xs:documentation>no subelements allowed</xs:documentation>
                  </xs:annotation>
                </xs:element>
                <xs:element name="Amount">
                  <xs:annotation>
                    <xs:documentation>### Ende der Elemente vom Typ "Task" ###</xs:documentation>
                  </xs:annotation>
                  <xs:complexType>
                    <xs:attribute ref="value"/>
                    <xs:attribute ref="unit"/>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Owner" minOccurs="1" type="xs:positiveInteger"> </xs:element>
                <xs:element name="Other" minOccurs="1" type="xs:positiveInteger"> </xs:element>
                <xs:element name="RefID" type="RefID"/>
                <xs:element name="TriggerDate"/>
                <xs:element name="Description">
                  <xs:simpleType>
                    <xs:restriction base="Description">
                      <xs:minLength value="1"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
              </xs:sequence>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="TaxTask">
        <xs:annotation>
          <xs:documentation>Mitarbeiter Gehalt</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:complexContent>
            <xs:extension base="Task">
              <xs:sequence>
                <xs:element name="Files">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="File" maxOccurs="1" minOccurs="0" type="FileType">
                      </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Bookings">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="Booking" maxOccurs="1" minOccurs="1" type="Booking">
                      </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Amount">
                  <xs:annotation>
                    <xs:documentation>### Ende der Elemente vom Typ "Task" ###</xs:documentation>
                  </xs:annotation>
                  <xs:complexType>
                    <xs:attribute ref="value"/>
                    <xs:attribute ref="unit"/>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Owner" type="xs:positiveInteger"> </xs:element>
                <xs:element name="RefID" type="xs:string" minOccurs="0"/>
                <xs:element name="Tax">
                  <xs:complexType>
                    <xs:attribute name="typeOfTax"/>
                    <xs:attribute name="period"/>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Description" type="xs:string"/>
              </xs:sequence>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="EmployeeSalaryTask">
        <xs:annotation>
          <xs:documentation>Mitarbeiter Gehalt</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:complexContent>
            <xs:extension base="Task">
              <xs:sequence>
                <xs:element name="Files">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="File" maxOccurs="1" minOccurs="0" type="FileType">
                      </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Bookings">
                  <xs:complexType>
                    <xs:sequence maxOccurs="8" minOccurs="8">
                      <xs:element name="Booking" maxOccurs="1" minOccurs="1" type="Booking">
                      </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Amount">
                  <xs:annotation>
                    <xs:documentation>### Ende der Elemente vom Typ "Task" ###</xs:documentation>
                  </xs:annotation>
                  <xs:complexType>
                    <xs:attribute ref="value"/>
                    <xs:attribute ref="unit"/>
                  </xs:complexType>
                </xs:element>
                <xs:element name="EmployeeID">
                  <xs:simpleType>
                    <xs:restriction base="xs:positiveInteger"> </xs:restriction>
                  </xs:simpleType>
                </xs:element>
                <xs:element name="EmployeeName">
                  <xs:simpleType>
                    <xs:restriction base="xs:string">
                      <xs:minLength value="4"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
                <xs:element name="SalaryMonth">
                  <xs:simpleType>
                    <xs:restriction base="xs:string">
                      <xs:minLength value="2"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
                <xs:element name="GrossSalary">
                  <xs:simpleType>
                    <xs:restriction base="xs:decimal">
                      <xs:minExclusive value="0"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
                <xs:element name="TaxBasedComission">
                  <xs:simpleType>
                    <xs:restriction base="xs:decimal">
                      <xs:minInclusive value="0"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
                <xs:element name="SozialSecurityCommission">
                  <xs:simpleType>
                    <xs:restriction base="xs:decimal">
                      <xs:minInclusive value="0"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
                <xs:element name="AmountPaid">
                  <xs:simpleType>
                    <xs:restriction base="xs:decimal">
                      <xs:minExclusive value="0"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
                <xs:element name="SozialSecurityEmloyeeContribution">
                  <xs:simpleType>
                    <xs:restriction base="xs:decimal">
                      <xs:minInclusive value="0"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
                <xs:element name="SozialSecurityEmployeeAddition">
                  <xs:simpleType>
                    <xs:restriction base="xs:decimal">
                      <xs:minInclusive value="0"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
                <xs:element name="OverallCosts">
                  <xs:simpleType>
                    <xs:restriction base="xs:decimal">
                      <xs:minInclusive value="0"/>
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
                <xs:element name="Owner" type="xs:positiveInteger"> </xs:element>
                <xs:element name="Description" type="xs:string"/>
              </xs:sequence>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:group>
  <xs:group name="AttachTasks">
    <xs:choice>
      <xs:element name="CommodityTask">
        <xs:annotation>
          <xs:documentation>Waren / Artikel</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:complexContent>
            <xs:extension base="Task">
              <xs:sequence>
                <xs:element name="Files">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="File" maxOccurs="1" minOccurs="0" type="FileType">
                      </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Bookings">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="Booking" maxOccurs="1" minOccurs="1" type="Booking">
                      </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Amount">
                  <xs:annotation>
                    <xs:documentation>### Ende der Elemente vom Typ "Task" ###</xs:documentation>
                  </xs:annotation>
                  <xs:complexType>
                    <xs:attribute ref="value"/>
                    <xs:attribute ref="unit"/>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Tax">
                  <xs:complexType>
                    <xs:attribute name="key" use="required">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="L+U-0"/>
                          <xs:enumeration value="L+X-0"/>
                          <xs:enumeration value="L-0"/>
                          <xs:enumeration value="L-7"/>
                          <xs:enumeration value="L-19"/>
                          <xs:enumeration value="EU+U-0"/>
                          <xs:enumeration value="EU+X-0"/>
                          <xs:enumeration value="EU-0"/>
                          <xs:enumeration value="EU-7"/>
                          <xs:enumeration value="EU-19"/>
                          <xs:enumeration value="EU+RC-7"/>
                          <xs:enumeration value="EU+RC-19"/>
                          <xs:enumeration value="I-0"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute name="region">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="inland"/>
                          <xs:enumeration value="EU"/>
                          <xs:enumeration value="international"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:attribute>
                    <xs:attribute name="type">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="GOODS"/>
                          <xs:enumeration value="SERVICE"/>
                          <xs:enumeration value="VIRTUAL"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:attribute>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Other" type="xs:positiveInteger"> </xs:element>
                <xs:element name="Description" type="xs:string"/>
              </xs:sequence>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="DeliveryNoteTask" minOccurs="1">
        <xs:annotation>
          <xs:documentation>Lieferschein</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:complexContent>
            <xs:extension base="Task">
              <xs:sequence>
                <xs:element name="Files">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="File" maxOccurs="1" type="FileType"> </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Bookings"> </xs:element>
                <xs:element name="RefID" type="xs:string" minOccurs="0"/>
                <xs:element name="Description" type="xs:string" minOccurs="0"/>
              </xs:sequence>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="DiscountTask" minOccurs="1">
        <xs:annotation>
          <xs:documentation>Skonto (nicht jedoch Rabatt = rebate)</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:complexContent>
            <xs:extension base="Task">
              <xs:sequence>
                <xs:element name="Files">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="File" maxOccurs="1" minOccurs="0" type="FileType">
                      </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Bookings">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="Booking" maxOccurs="1" minOccurs="1" type="Booking">
                      </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Amount">
                  <xs:annotation>
                    <xs:documentation>### Ende der Elemente vom Typ "Task" ###</xs:documentation>
                  </xs:annotation>
                  <xs:complexType>
                    <xs:attribute ref="value"/>
                    <xs:attribute ref="unit"/>
                  </xs:complexType>
                </xs:element>
                <xs:element name="RefID" type="xs:string" minOccurs="0"/>
                <xs:element name="Description" type="xs:string" minOccurs="0"/>
              </xs:sequence>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="DunningChargeTask" minOccurs="1">
        <xs:annotation>
          <xs:documentation>Mahngebühr</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:complexContent>
            <xs:extension base="Task">
              <xs:sequence>
                <xs:element name="Files">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="File" maxOccurs="1" minOccurs="0" type="FileType">
                      </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Bookings">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="Booking" maxOccurs="1" minOccurs="1" type="Booking">
                      </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Amount">
                  <xs:annotation>
                    <xs:documentation>### Ende der Elemente vom Typ "Task" ###</xs:documentation>
                  </xs:annotation>
                  <xs:complexType>
                    <xs:attribute ref="value"/>
                    <xs:attribute ref="unit"/>
                  </xs:complexType>
                </xs:element>
                <xs:element name="RefID" type="xs:string" minOccurs="0"/>
                <xs:element name="Description" type="xs:string" minOccurs="0"/>
              </xs:sequence>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="PaymentTask" maxOccurs="1" minOccurs="1">
        <xs:annotation>
          <xs:documentation>Bezahlung</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:complexContent>
            <xs:extension base="Task">
              <xs:sequence>
                <xs:element name="Files">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="File" maxOccurs="1" minOccurs="1" type="FileType">
                      </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Bookings">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="Booking" maxOccurs="1" type="Booking"> </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Amount">
                  <xs:annotation>
                    <xs:documentation>### Ende der Elemente vom Typ "Task" ###</xs:documentation>
                  </xs:annotation>
                  <xs:complexType>
                    <xs:attribute ref="value"/>
                    <xs:attribute ref="unit"/>
                  </xs:complexType>
                </xs:element>
                <xs:element name="RefID" type="xs:string"/>
                <xs:element name="Description" type="xs:string" minOccurs="0"/>
                <xs:element name="Trigger" minOccurs="0"/>
              </xs:sequence>
              <xs:attribute name="paymentType"/>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="TransferVoucherTask" maxOccurs="1" minOccurs="1">
        <xs:annotation>
          <xs:documentation>Bezahlung</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:complexContent>
            <xs:extension base="Task">
              <xs:sequence>
                <xs:element name="Files">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="File" maxOccurs="1" minOccurs="1" type="FileType">
                      </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Bookings"> </xs:element>
                <xs:element name="Amount">
                  <xs:annotation>
                    <xs:documentation>### Ende der Elemente vom Typ "Task" ###</xs:documentation>
                  </xs:annotation>
                  <xs:complexType>
                    <xs:attribute ref="value"/>
                    <xs:attribute ref="unit"/>
                  </xs:complexType>
                </xs:element>
                <xs:element name="RefID" type="xs:string" minOccurs="0"/>
                <xs:element name="Description" type="xs:string" minOccurs="0"/>
              </xs:sequence>
              <xs:attribute name="paymentType"/>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="AttachmentTask" maxOccurs="1" minOccurs="1">
        <xs:annotation>
          <xs:documentation>Anhang - zur Information</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:complexContent>
            <xs:extension base="Task">
              <xs:sequence>
                <xs:element name="Files">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="File" maxOccurs="1" minOccurs="1" type="FileType">
                      </xs:element>
                    </xs:sequence>
                  </xs:complexType>
                </xs:element>
                <xs:element name="Bookings"> </xs:element>
                <xs:element name="Amount">
                  <xs:annotation>
                    <xs:documentation>### Ende der Elemente vom Typ "Task" ###</xs:documentation>
                  </xs:annotation>
                  <xs:complexType>
                    <xs:attribute ref="value"/>
                    <xs:attribute ref="unit"/>
                  </xs:complexType>
                </xs:element>
                <xs:element name="DocName" type="xs:string" minOccurs="0"/>
                <xs:element name="RefID" type="xs:string" minOccurs="0"/>
                <xs:element name="Description" type="xs:string"/>
              </xs:sequence>
              <xs:attribute name="paymentType"/>
            </xs:extension>
          </xs:complexContent>
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:group>
  <xs:complexType name="Task">
    <xs:sequence>
      <xs:annotation>
        <xs:documentation>"Files", "Booking" und "Amount" sind mandatory Element. Doch da im XML
          Schema 1.0 keine Restrictions auf deren Child Elemente Anzahl gemacht werden kann, sind
          diese am jeweiligen Object definiert.</xs:documentation>
      </xs:annotation>
      <xs:element minOccurs="0" name="Notes" type="Notes"> </xs:element>
    </xs:sequence>
    <xs:attribute name="type" type="AllType"> </xs:attribute>
    <xs:attribute name="id" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:ID">
          <xs:pattern value="ACC([0-9a-f\-]+|xxx)"/>
          <xs:minLength value="6"/>
          <xs:maxLength value="40"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="date" use="required" type="xs:date"/>
    <xs:attribute name="created" use="required" type="xs:dateTime"/>
    <xs:attribute name="changed" type="xs:dateTime"/>
    <xs:attribute name="user" use="required" type="xs:string"/>
    <xs:attribute name="isStorno" type="xs:boolean"> </xs:attribute>
    <xs:attribute name="isMaster" type="xs:boolean"> </xs:attribute>
  </xs:complexType>
  <xs:attribute name="unit">
    <xs:simpleType>
      <xs:restriction base="xs:string">
        <xs:enumeration value="EUR"/>
        <xs:enumeration value="USD"/>
      </xs:restriction>
    </xs:simpleType>
  </xs:attribute>
  <xs:attribute name="value">
    <xs:simpleType>
      <xs:restriction base="xs:decimal">
        <xs:fractionDigits value="2"/>
      </xs:restriction>
    </xs:simpleType>
  </xs:attribute>
  <xs:simpleType name="Description">
    <xs:restriction base="xs:string"/>
  </xs:simpleType>
  <xs:simpleType name="RefID">
    <xs:restriction base="xs:normalizedString">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="TransactionID">
    <xs:restriction base="xs:normalizedString"/>
  </xs:simpleType>
  <xs:simpleType name="Notes">
    <xs:restriction base="xs:string"/>
  </xs:simpleType>
  <xs:simpleType name="Filename">
    <xs:annotation>
      <xs:documentation>20[10-99]\-[01|02|03|04|05|06|07|08|08|10|11|12]\-[01|02|03|04|05|06|07|08|09|10-31][A-Za-z0-9_\-\(\)]+</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="(([0-9]{4})-?(1[0-2]|0[1-9])-?(3[01]|0[1-9]|[12][0-9])_[A-Za-z0-9_\-\(\)]+|PAY[0-9a-f\-]+)"/>
      <xs:minLength value="5"/>
      <xs:maxLength value="150"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="Booking">
    <xs:attribute name="date" use="required" type="xs:date"/>
    <xs:attribute name="quality" use="required" type="xs:integer"/>
    <xs:attribute name="amountValue" type="xs:decimal"/>
    <xs:attribute name="amountUnit" type="xs:string"/>
    <xs:attribute name="debit" type="xs:positiveInteger"/>
    <xs:attribute name="credit" type="xs:positiveInteger"/>
    <xs:attribute name="taxKey"/>
    <xs:attribute name="taxAmount" type="xs:decimal"/>
    <xs:attribute name="description" type="xs:string"/>
    <xs:attribute name="refID" type="xs:string"/>
  </xs:complexType>
  <xs:simpleType name="AllType">
    <xs:union memberTypes="TaskType DocType"/>
  </xs:simpleType>
  <xs:simpleType name="TaskType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="bank-balancing"/>
      <xs:enumeration value="discount"/>
      <xs:enumeration value="invoice-in"/>
      <xs:enumeration value="invoice-in-storno"/>
      <xs:enumeration value="invoice-out"/>
      <xs:enumeration value="invoice-out-storno"/>
      <xs:enumeration value="payment-bank"/>
      <xs:enumeration value="transfer-voucher"/>
      <xs:enumeration value="note"/>
      <xs:enumeration value="account-settlement"/>
      <xs:enumeration value="dunning-fee"/>
      <xs:enumeration value="document"/>
      <xs:enumeration value="delivery-note"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="DocType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="doc-bank-statement"/>
      <xs:enumeration value="doc-bank-transfer"/>
      <xs:enumeration value="doc-contract"/>
      <xs:enumeration value="doc-delivery-note"/>
      <xs:enumeration value="doc-dunning-charge"/>
      <xs:enumeration value="doc-information"/>
      <xs:enumeration value="doc-invoice-in"/>
      <xs:enumeration value="doc-invoice-in-storno"/>
      <xs:enumeration value="doc-invoice-out"/>
      <xs:enumeration value="doc-invoice-out-storno"/>
      <xs:enumeration value="doc-periodic-payment"/>
      <xs:enumeration value="doc-payment-cash"/>
      <xs:enumeration value="doc-payment-bank"/>
      <xs:enumeration value="doc-payslip"/>
      <xs:enumeration value="doc-tax"/>
      <xs:enumeration value="doc-undefined"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="FileType">
    <xs:attribute name="archived" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:boolean">
          <xs:pattern value="true"/>
          <xs:pattern value="false"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="doctype" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="digital"/>
          <xs:enumeration value="paper"/>
          <xs:enumeration value="undefined"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="fileExtension" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:NMTOKEN">
          <xs:pattern value=".pdf"/>
          <xs:pattern value=".csv"/>
          <xs:pattern value=".png"/>
          <xs:pattern value=".tiff"/>
          <xs:pattern value=".tif"/>
          <xs:pattern value=".jpg"/>
          <xs:pattern value=".jpeg"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="fileName" use="required">
      <xs:simpleType>
        <xs:restriction base="Filename"/>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="mimeType" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[A-Za-z\-]+/[A-Za-z\-]+"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="src" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:anyURI">
          <xs:minLength value="5"/>
          <xs:maxLength value="254"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="type" use="required" type="DocType"/>
    <xs:attribute name="uploadName" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:minLength value="3"/>
          <xs:maxLength value="255"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="uploadSrc" type="xs:anyURI"/>
  </xs:complexType>
</xs:schema>