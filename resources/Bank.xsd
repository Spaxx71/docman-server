<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="BankAccount">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="BankAccountDetail">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="BankName" type="xs:string"/>
              <xs:element name="AccountName" type="xs:string"/>
              <xs:element name="AccountNick" type="xs:string"/>
              <xs:element name="KTNR">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:pattern value="([0-9]{5,11})?"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="BLZ">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:pattern value="([0-9]{8})?"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="IBAN">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:pattern value="([A-Z]{2}[0-9]{20})?"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="BIC">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:pattern value="([A-Z0-9]{8,11})?"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="BankUserID" type="xs:string" minOccurs="0"/>
              <xs:element name="CustomerID" type="xs:string" minOccurs="0"/>
              <xs:element name="CustomerName" type="xs:string" minOccurs="0"/>
              <xs:element name="CurrencyUnit" type="xs:NCName"/>
              <xs:element name="OnlineBanking" minOccurs="0">
                <xs:complexType>
                  <xs:sequence maxOccurs="1" minOccurs="0">
                    <xs:element name="Auth">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="PIN" type="xs:string"/>
                        </xs:sequence>
                        <xs:attribute name="type">
                          <xs:simpleType>
                            <xs:restriction base="xs:string"/>
                          </xs:simpleType>
                        </xs:attribute>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Hostname" type="xs:string"/>
                    <xs:element name="Port" type="xs:positiveInteger"/>
                    <xs:element name="MessageIn">
                      <xs:complexType>
                        <xs:attribute name="url" type="xs:anyURI"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="MessageOut">
                      <xs:complexType>
                        <xs:attribute name="url" type="xs:anyURI"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Passport">
                      <xs:complexType>
                        <xs:attribute name="url" type="xs:anyURI"/>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="Parameters">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element minOccurs="0" name="Parameter" maxOccurs="unbounded">
                            <xs:complexType>
                              <xs:simpleContent>
                                <xs:extension base="xs:string">
                                  <xs:attribute name="name" use="required">
                                    <xs:simpleType>
                                      <xs:restriction base="xs:string">
                                        <xs:minLength value="1"/>
                                      </xs:restriction>
                                    </xs:simpleType>
                                  </xs:attribute>
                                </xs:extension>
                              </xs:simpleContent>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="Notes" type="xs:string"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element ref="Accountings"/>
      </xs:sequence>
      <xs:attribute name="kto" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[A-Za-z0-9]+"/>
            <xs:minLength value="5"/>
            <xs:maxLength value="15"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
  <xs:element name="Accountings">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Accounting" maxOccurs="unbounded" minOccurs="0">
          <xs:complexType>
            <xs:all>
              <xs:element name="SalesType">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string">
                      <xs:attribute name="key" type="xs:string"/>
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
              <xs:element name="BookingDate" type="xs:date"/>
              <xs:element name="ValueDate" type="xs:date"/>
              <xs:element name="Recipient" type="xs:string" minOccurs="0" maxOccurs="1"/>
              <xs:element name="DivergentRecepient" minOccurs="0" maxOccurs="1">
                <xs:complexType mixed="true">
                  <xs:attribute name="type" use="required" type="xs:NCName"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="PaymentDetail" type="xs:string" minOccurs="0"/>
              <xs:element name="Usage" type="xs:string" minOccurs="0"/>
              <xs:element name="IBAN" type="xs:string" minOccurs="0" maxOccurs="1"/>
              <xs:element name="BIC" type="xs:string" minOccurs="0" maxOccurs="1"/>
              <xs:element name="MandantRef" minOccurs="0" maxOccurs="1"/>
              <xs:element name="CustomerRef" type="xs:string" maxOccurs="1"/>
              <xs:element name="EndToEndRef" type="xs:string" maxOccurs="1"/>
              <xs:element name="CreditorID" type="xs:string" minOccurs="0" maxOccurs="1"/>
              <xs:element name="Primanota" type="xs:string" minOccurs="0" maxOccurs="1"/>
              <xs:element name="AddKey" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string"> </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
              <xs:element name="Amount">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:decimal">
                      <xs:attribute name="type">
                        <xs:simpleType>
                          <xs:restriction base="xs:string">
                            <xs:enumeration value="DEBIT"/>
                            <xs:enumeration value="CREDIT"/>
                          </xs:restriction>
                        </xs:simpleType>
                      </xs:attribute>
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
              <xs:element name="OriginalAmount" type="xs:string" minOccurs="0" maxOccurs="1"/>
              <xs:element name="CurrencyUnit" type="xs:NCName"/>
              <xs:element name="ExternalCosts" minOccurs="0" type="xs:string" maxOccurs="1"/>
            </xs:all>
            <xs:attribute name="id" use="required">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:pattern value="(PAY[0-9a-f\-]+|PAYxxx)"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="isStorno" use="optional"/>
            <xs:attribute name="oid" use="optional"/>
            <xs:attribute name="saldoAmount" use="required" type="xs:decimal"/>
            <xs:attribute name="saldoTimestamp" use="optional" type="xs:dateTime"/>
            <xs:attribute name="origin">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:enumeration value="FinTS"/>
                  <xs:enumeration value="CSV"/>
                  <xs:enumeration value="Manual"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="isSepa" type="xs:boolean"/>
            <xs:attribute name="isCamt" type="xs:boolean"/>
            <xs:attribute name="budgetCategory" use="required" type="xs:token"/>
          </xs:complexType>
          <xs:key name="AccountingIDKey">
            <xs:selector xpath="Accounting"/>
            <xs:field xpath="@id"/>
          </xs:key>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="saldoInitAmount" use="required" type="xs:decimal"/>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="NonEmptyString">
    <xs:simpleContent>
      <xs:extension base="xs:string"/>
    </xs:simpleContent>
  </xs:complexType>
</xs:schema>