<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:element name="Accounts">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Account" type="AccountType" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="chart" use="optional">
        <xs:simpleType>
          <xs:restriction base="xs:NCName">
            <xs:enumeration value="SKR03"/>
            <xs:enumeration value="SKR04"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="personNumbers" use="optional">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="A-Z"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
    </xs:complexType>
    <xs:key name="AccountIdKey">
      <xs:selector xpath="Account"/>
      <xs:field xpath="@id"/>
    </xs:key>
  </xs:element>

  <xs:element name="Account" type="AccountType"/>

  <xs:complexType name="AccountType">
    <xs:sequence>
      <xs:element name="Name">
        <xs:simpleType>
          <xs:restriction base="xs:normalizedString">
            <xs:minLength value="1"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="Notes" type="xs:string"/>
      <xs:element name="BudgetCategories">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="BudgetCategory" minOccurs="0" maxOccurs="50">
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="Period">
                    <xs:complexType>
                      <xs:attribute name="valid-from" type="xs:date" use="required"/>
                      <xs:attribute name="valid-till" type="xs:date" use="optional"/>
                    </xs:complexType>
                  </xs:element>
                  <xs:element name="PaymentRules">
                    <xs:complexType>
                      <xs:sequence>
                        <xs:element name="PaymentRule" type="PaymentRuleType" minOccurs="0" maxOccurs="50"/>
                      </xs:sequence>
                    </xs:complexType>
                  </xs:element>
                  <xs:element name="Notes" type="xs:string" minOccurs="0"/>
                </xs:sequence>
                <xs:attribute name="id" type="xs:string" use="required"/>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="Accounting">
        <xs:complexType>
          <xs:attribute name="openingBalance" type="xs:decimal" use="required"/>
          <xs:attribute name="closingBalance" type="xs:decimal" use="required"/>
          <xs:attribute name="debitSum" type="xs:decimal" use="required"/>
          <xs:attribute name="creditSum" type="xs:decimal" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="classes" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="(self|creditor|debitor|assets|essets|revenues|liabilities|expenses|bank)(\s(self|creditor|debitor|assets|essets|revenues|expenses|liabilities|bank))*"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="id" use="required" type="xs:NMTOKEN"/>
    <xs:attribute name="kto" use="required" type="xs:integer"/>
    <xs:attribute name="type" use="required" type="xs:NCName"/>
    <xs:attribute name="contactsRef" type="xs:string" default=""/>
    <xs:attribute name="banksRef" type="xs:string" default=""/>
  </xs:complexType>

  <xs:complexType name="PaymentRuleType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="type" use="required">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="SEPA_DIRECT-DEBIT_IBAN"/>
              <xs:enumeration value="SEPA_DIRECT-DEBIT_CREDITOR-ID"/>
              <xs:enumeration value="SEPA_CREDIT-TRANSFER_IBAN"/>
              <xs:enumeration value="SEPA_PAYMENT-DETAILS_ASCII"/>
              <xs:enumeration value="SEPA_PAYMENT-DETAILS_REGEX"/>
              <xs:enumeration value="PAYER_BANK-ACCOUNT_CONCERNED"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="use" default="required">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="required"/>
              <xs:enumeration value="optional"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

</xs:schema>
